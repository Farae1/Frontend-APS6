# Copy to .env to change the defaults of compose.yaml.
HTTP_PORT=8080
HTTPS_PORT=8443
DATABASE_PASSWORD=change-me
VECTORS_PASSWORD=change-me
# Cosine similarity thresholds (see shared/common/settings.py).
MATCH_SAME_SESSION=0.5
MATCH_EMPLOYEE=0.5
# CPU threads per face inference (the Pi 5 has 4 cores).
FACE_THREADS=2
# How long a session lasts (face sign-in or base minister's password).
TOKEN_MINUTES=10
# Signs the session tokens; empty = random at each start.
TOKEN_SECRET=
